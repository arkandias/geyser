{
  "name": "@geyser/client",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:app": "vue-tsc --noEmit -p tsconfig.app.json",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:app",
    "codegen": "graphql-codegen",
    "codegen:schema": "graphql-codegen --config codegen.schema.ts"
  },
  "dependencies": {
    "@geyser/shared": "workspace:*",
    "@urql/core": "^6.0.3",
    "@urql/exchange-auth": "^3.0.0",
    "@urql/vue": "^2.1.1",
    "axios": "^1.20.0",
    "dompurify": "^3.4.14",
    "driver.js": "^1.8.0",
    "graphql": "^17.0.2",
    "marked": "^18.0.11",
    "papaparse": "^5.7.0",
    "quasar": "^2.28.0",
    "vue": "^3.5.42",
    "vue-i18n": "^11.4.10",
    "vue-router": "^5.3.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.23.0",
    "@graphql-codegen/cli": "^7.3.1",
    "@graphql-codegen/client-preset": "^6.1.3",
    "@graphql-codegen/schema-ast": "^6.1.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@quasar/vite-plugin": "^2.0.2",
    "@types/papaparse": "^5.5.2",
    "@urql/devtools": "^2.0.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "glob": "^13.0.6",
    "happy-dom": "^20.12.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "sass-embedded": "^1.103.1",
    "vite": "^8.2.2",
    "vite-plugin-compression2": "^2.5.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
